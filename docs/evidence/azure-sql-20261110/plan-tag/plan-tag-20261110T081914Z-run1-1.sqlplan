<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.613" Build="18.0.319.205"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH k AS (&#xa;        SELECT s.ordinal AS Ordinal, LTRIM(RTRIM(REPLACE(REPLACE(s.value, &apos;-&apos;, &apos;&apos;), &apos;+&apos;, &apos;&apos;))) AS Field,&#xa;               CASE WHEN LTRIM(s.value) LIKE &apos;-%&apos; THEN 1 ELSE 0 END AS Descending&#xa;        FROM STRING_SPLIT(COALESCE(NULLIF(LTRIM(RTRIM(@Sort)), &apos;&apos;), @defaultSort), &apos;,&apos;, 1) AS s&#xa;    ), f AS (&#xa;        SELECT Name, Expr FROM (VALUES&#xa;            (&apos;ticketId&apos;, N&apos;t.TicketId&apos;), (&apos;projectId&apos;, N&apos;t.ProjectId&apos;), (&apos;title&apos;, N&apos;t.Title&apos;), (&apos;status&apos;, N&apos;t.TicketStatus&apos;),&#xa;            (&apos;ticketStatus&apos;, N&apos;t.TicketStatus&apos;), (&apos;priority&apos;, N&apos;t.Priority&apos;), (&apos;ticketType&apos;, N&apos;t.TicketType&apos;),&#xa;            (&apos;category&apos;, N&apos;t.Category&apos;), (&apos;owner&apos;, N&apos;t.Owner&apos;), (&apos;assignedTo&apos;, N&apos;t.AssignedTo&apos;), (&apos;createdBy&apos;, N&apos;t.CreatedBy&apos;),&#xa;            (&apos;createdDate&apos;, N&apos;t.CreatedDate&apos;), (&apos;lastUpdateDate&apos;, N&apos;t.LastUpdateDate&apos;), (&apos;currentStatusDate&apos;, N&apos;t.CurrentStatusDate&apos;),&#xa;            (&apos;dueDate&apos;, N&apos;t.DueDate&apos;), (&apos;targetDate&apos;, N&apos;t.TargetDate&apos;), (&apos;resolutionDate&apos;, N&apos;t.ResolutionDate&apos;)) AS v (Name, Expr)&#xa;    )&#xa;    SELECT @keys = COUNT(*),&#xa;           @unknown = SUM(CASE WHEN f.Expr IS NULL THEN 1 ELSE 0 END),&#xa;           @duplicates = COUNT(f.Expr) - COUNT(DISTINCT f.Expr),&#xa;           @hasTicketId = MAX(CASE WHEN f.Expr = N&apos;t.TicketId&apos; THEN 1 ELSE 0 END),&#xa;           @order = STRING_AGG(CAST(f.Expr AS nvarchar(max)) + CASE WHEN k.Descending = 1 THEN N&apos; DESC&apos; ELSE N&apos;&apos; END, N&apos;, &apos;)&#xa;                    WITHIN GROUP (ORDER BY k.Ordinal)&#xa;    FROM k LEFT JOIN f ON f.Name = k.Field COLLATE Latin1_General_CI_AS" StatementId="1" StatementCompId="60" StatementType="SELECT" StatementSqlHandle="0x09000781F64BC76B27A665E9085EF67739960000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="1525580473" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0395012" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE552F3971CC2B2F5" QueryPlanHash="0x09A862ED10F4ED98" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1024" CachedPlanSize="88" CompileTime="3" CompileCPU="3" CompileMemory="1488"><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT(nvarchar(max),[Expr1039],0)"></PlanAffectingConvert></Warnings><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="544" RequiredMemory="512" DesiredMemory="544" RequestedMemory="1024" GrantWaitTime="0" MaxQueryMemory="818008" GrantedMemory="1024" MaxUsedMemory="0" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="314572" EstimatedPagesCached="39321" EstimatedAvailableDegreeOfParallelism="2" MaxCompileMemory="3673896"></OptimizerHardwareDependentProperties><QueryTimeStats ElapsedTime="0" CpuTime="0"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1" EstimateIO="0" EstimateCPU="1e-07" AvgRowSize="4051" EstimatedTotalSubtreeCost="0.0395012" Parallel="0" E