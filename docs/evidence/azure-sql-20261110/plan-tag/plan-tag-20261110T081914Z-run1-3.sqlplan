<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.613" Build="18.0.319.205"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT t.TicketId, t.ProjectId, t.Title, t.TicketType, t.Category, t.Priority, t.TicketStatus,&#xa;    t.Owner, o.DisplayName AS OwnerDisplayName, t.AssignedTo, a.DisplayName AS AssignedToDisplayName,&#xa;    t.CreatedDate, t.LastUpdateDate, t.DueDate, t.TargetDate, t.TagList&#xa;FROM (SELECT t.TicketId FROM dbo.Tickets AS t WHERE 1 = 1 AND EXISTS (SELECT 1 FROM dbo.TicketTags AS g WHERE g.TicketId = t.TicketId AND g.TagName = @Tag)&#xa;      ORDER BY t.LastUpdateDate DESC, t.TicketId OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY) AS k&#xa;JOIN dbo.Tickets AS t ON t.TicketId = k.TicketId&#xa;LEFT JOIN dbo.IdentityUsers AS o ON o.Id = t.Owner&#xa;LEFT JOIN dbo.IdentityUsers AS a ON a.Id = t.AssignedTo&#xa;ORDER BY t.LastUpdateDate DESC, t.TicketId" StatementId="3" StatementCompId="79" StatementType="SELECT" StatementSqlHandle="0x0900780A8616B380697C0F6809902E92DCC00000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="3" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="0.196766" StatementEstRows="20.002" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x6AE9591158CE9B37" QueryPlanHash="0xADD1AA2535AF4BBF" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1728" CachedPlanSize="120" CompileTime="30" CompileCPU="25" CompileMemory="1096"><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="1728" RequiredMemory="1536" DesiredMemory="1728" RequestedMemory="1728" GrantWaitTime="0" MaxQueryMemory="8180