      "description": "GET /search?term=tags:printer",
      "commands": [
        {
          "commandType": "Text",
          "text": "WITH hits (TicketId, Score) AS (\n    SELECT ft.[KEY], ft.[RANK] * 2.5 / SQRT(CASE WHEN n.Tags \u003E 0 THEN n.Tags ELSE 1 END) FROM CONTAINSTABLE(dbo.Tickets, TagList, @c0) ft LEFT HASH JOIN (SELECT TicketId, COUNT(*) AS Tags FROM dbo.TicketTags GROUP BY TicketId) n ON n.TicketId = ft.[KEY]\n)\nSELECT TOP (@top1) h.TicketId, CAST(SUM(h.Score) AS float) AS Score\nFROM hits h JOIN dbo.Tickets t ON t.TicketId = h.TicketId\nGROUP BY h.TicketId\nORDER BY Score DESC, h.TicketId;\n",
