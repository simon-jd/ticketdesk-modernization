    {
      "name": "search-printer",
      "description": "GET /search?term=printer (golden query; 66,582 titles at L)",
      "commands": [
        {
          "commandType": "Text",
          "text": "WITH hits (TicketId, Score) AS (\n    SELECT ft.[KEY], ft.[RANK] * 2.0 FROM CONTAINSTABLE(dbo.Tickets, Title, @c0) ft\n    UNION ALL SELECT ft.[KEY], ft.[RANK] * 1.0 FROM CONTAINSTABLE(dbo.Tickets, Details, @c1) ft\n    UNION ALL SELECT ft.[KEY], ft.[RANK] * 2.5 / SQRT(CASE WHEN n.Tags \u003E 0 THEN n.Tags ELSE 1 END) FROM CONTAINSTABLE(dbo.Tickets, TagList, @c2) ft LEFT HASH JOIN (SELECT TicketId, COUNT(*) AS Tags FROM dbo.TicketTags GROUP BY TicketId) n ON n.TicketId = ft.[KEY]\n    UNION ALL SELECT e.TicketId, ft.[RANK] * 0.75 FROM CONTAINSTABLE(dbo.TicketEvents, Comment, @c3) ft JOIN dbo.TicketEvents e ON e.EventId = ft.[KEY]\n)\nSELECT TOP (@top4) h.TicketId, CAST(SUM(h.Score) AS float) AS Score\nFROM hits h JOIN dbo.Tickets t ON t.TicketId = h.TicketId\nGROUP BY h.TicketId\nORDER BY Score DESC, h.TicketId;\n",
