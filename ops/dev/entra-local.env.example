# Template for ops/dev/entra-local.sh (Entra ID sign-in of TicketDesk.Web on https://localhost:5443).
# Copy it OUTSIDE the repository (or to ops/dev/entra-local.env, which is git-ignored), chmod 600, fill in the values.
# The variable names are ASP.NET Core configuration keys (section Authentication:EntraId, see EntraIdOptions).
#
# App registration (Entra admin center > App registrations > New registration):
#   supported account types: this organizational directory only (AzureADMyOrg)
#   redirect URI (platform Web): https://localhost:5443/signin-oidc     front-channel logout: https://localhost:5443/signout-oidc
#   app roles (optional, values as the legacy roles): TdAdministrators, TdHelpDeskUsers, TdInternalUsers, TdPendingUsers
#   a client secret (Certificates & secrets) with a short lifetime (30 days or less)
Authentication__EntraId__Enabled=true
Authentication__EntraId__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
Authentication__EntraId__TenantId=<tenant-id>
Authentication__EntraId__ClientId=<application-client-id>
Authentication__EntraId__ClientSecret=<client-secret-value>
Authentication__EntraId__DisplayName=Entra ID
