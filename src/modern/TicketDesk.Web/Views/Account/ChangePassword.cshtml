@* Port of the legacy Views/Account/ChangePassword.cshtml (TicketDesk 2.5, Ms-PL). *@
@using ChangePasswordStrings = TicketDesk.Localization.Views.Account.ChangePassword
@using TicketDesk.Web.Controllers
@{
    var f = AccountController.PasswordFields.ToDictionary(x => x.Name);
}
@section title
{
    @ChangePasswordStrings.Title
}
@section Scripts {
}
<main>
    <div class="container">
        <fieldset>
            <legend class="col-lg-8 col-lg-offset-2 col-md-9 col-md-offset-1 col-sm-12">@ChangePasswordStrings.Legend</legend>
            <div class="col-lg-7 col-lg-offset-3 col-md-8 col-md-offset-2 col-sm-12">
<form action="/account/change-password" class="form-horizontal" method="post" role="form">@Html.AntiForgeryToken()                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h2 class="panel-title">@ChangePasswordStrings.Header</h2>
                        </div>
                        <div class="panel-body">


                            @LegacyForm.ValidationSummary(ViewData.ModelState)
                            <div class="form-group">
                                @LegacyForm.Label(f["OldPassword"], "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.Password(f["OldPassword"], state: ViewData.ModelState)
                                </div>
                            </div>
                            <div class="form-group">
                                @LegacyForm.Label(f["NewPassword"], "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.Password(f["NewPassword"], state: ViewData.ModelState)
                                </div>
                            </div>
                            <div class="form-group">
                                @LegacyForm.Label(f["ConfirmPassword"], "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.Password(f["ConfirmPassword"], state: ViewData.ModelState)
                                </div>
                            </div>
                        </div>
                        <div class="panel-footer">
                            <button type="submit" class="btn btn-success" tabindex="10">@ChangePasswordStrings.SaveOption</button>&nbsp;&nbsp;
                            <a href="/account/manage">@ChangePasswordStrings.BackOption</a>
                        </div>
                    </div>
</form>            </div>
        </fieldset>
    </div>
</main>
