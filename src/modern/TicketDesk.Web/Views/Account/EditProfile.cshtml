@* Port of the legacy Views/Account/EditProfile.cshtml (TicketDesk 2.5, Ms-PL). *@
@model TicketDesk.Web.Controllers.AccountController.Profile
@using EditProfileStrings = TicketDesk.Localization.Views.Account.EditProfile
@using TicketDesk.Web.Controllers
@{
    var f = AccountController.ProfileFields.ToDictionary(x => x.Name);
}
@section title
{
    @EditProfileStrings.Title
}
@section Scripts {
}
<main>
    <div class="container">
        <fieldset>
            <legend class="col-lg-8 col-lg-offset-2 col-md-9 col-md-offset-1 col-sm-12">@EditProfileStrings.Legend</legend>
            <div class="col-lg-7 col-lg-offset-3 col-md-8 col-md-offset-2 col-sm-12">
<form action="/account/edit-profile" class="form-horizontal" method="post" role="form">                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h2 class="panel-title">@EditProfileStrings.Header</h2>
                        </div>
                        <div class="panel-body">

                            @Html.AntiForgeryToken()
                            @LegacyForm.ValidationSummary(ViewData.ModelState)

                            <div class="form-group">
                                @LegacyForm.Label(f["Email"], "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(f["Email"], Model.Email, state: ViewData.ModelState)
                                    @LegacyForm.ValidationMessage(f["Email"], ViewData.ModelState)
                                </div>
                            </div>

                            <div class="form-group">
                                @LegacyForm.Label(f["DisplayName"], "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(f["DisplayName"], Model.DisplayName, state: ViewData.ModelState)
                                </div>
                            </div>

                        </div>
                        <div class="panel-footer">
                            <button type="submit" class="btn btn-success" tabindex="10">@EditProfileStrings.SaveOption</button>&nbsp;&nbsp;
                            <a href="/account/manage">@EditProfileStrings.BackOption</a>
                        </div>
                    </div>
</form>            </div>
        </fieldset>
    </div>
</main>
