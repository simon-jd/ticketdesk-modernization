@* Port of the legacy Views/ProjectSettings/Index.cshtml (TicketDesk 2.5, Ms-PL). *@
@model IReadOnlyList<TicketDesk.Projects.ProjectWithTicketCount>
@using ProjectsIndex = TicketDesk.Localization.Views.ProjectSettings.Index

@section title
{
    @ProjectsIndex.Title
}
@section scripts
{
    @Bundles.Scripts("~/bundles/project-settings")
    <script type="text/javascript">
        $(document).ready(function () {
            $(".clickable").clickable();
        });
    </script>
}

<main>
    <div class="container-fluid">
        <fieldset>
            <legend class="col-sm-12">
                @ProjectsIndex.Legend
                <span data-toggle="tooltip"
                      data-placement="top"
                      title="@ProjectsIndex.Legend_ShowMore">
                    <span class="btn btn-link btn-lg" type="button"
                          data-toggle="collapse"
                          href="#collapseProjectDescription"
                          aria-expanded="false"
                          aria-controls="collapseRoleDescription">
                        <i class="fa fa-info-circle"></i>
                    </span>
                </span>
            </legend>
            <div class="col-sm-12">
                <div class="collapse" id="collapseProjectDescription">
                    <div class="well text-muted">
                        @Html.Raw(ProjectsIndex.Legend_MoreInfo)
                    </div>
                </div>
                <div class="panel panel-info">

                    <div class="panel-body" style="padding: 0;">

                        <div class="table-responsive">
                            <table class="table table-striped table-condensed table-hover ">
                                <tr>
                                    <th>
                                        @ProjectsIndex.Project
                                    </th>
                                    <th>
                                        @ProjectsIndex.Description
                                    </th>
                                    <th>
                                        @ProjectsIndex.Tickets
                                    </th>

                                </tr>
                                @foreach (var item in Model)
                                {
                                    <tr class="clickable">
                                        <td>
                                            <a href="/admin/project/@item.ProjectId">
                                                @item.ProjectName
                                            </a>
                                        </td>
                                        <td>@item.ProjectDescription</td>
                                        <td>@item.NumberOfTickets</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                    <div class="panel-footer">
                        <div class="">

                            <a href="/admin/project/new" class="btn btn-primary">
                                <i class="fa fa-plus"></i>&nbsp;&nbsp;@ProjectsIndex.SaveOption
                            </a>


                        </div>
                    </div>

                </div>


            </div>
        </fieldset>
    </div>
</main>
