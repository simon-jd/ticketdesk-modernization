@* Port of the legacy Views/UserAdministration/Index.cshtml (TicketDesk 2.5, Ms-PL). *@
@model TicketDesk.Users.UserAccountPage
@using AdminIndex = TicketDesk.Localization.Views.UserAdministration.Index
@section title{
    @AdminIndex.Title
}
@section scripts
{
    @Bundles.Scripts("~/bundles/admin-users")
    <script type="text/javascript">
        $(document).ready(function () {
            window.adminUsers.activate();
        });
    </script>
}
<main>
    <div class="container">
        <fieldset>
            <legend class="col-sm-12">@AdminIndex.Legend</legend>
            <div class="col-sm-12">
                <partial name="_UserList" model="Model" />
            </div>
            <div class="panel-footer">
                <div class="">
                    <a href="/admin/new" class="btn btn-primary">
                        <i class="fa fa-plus"></i>&nbsp;&nbsp;@AdminIndex.NewUser
                    </a>
                </div>
            </div>
        </fieldset>
    </div>
</main>
