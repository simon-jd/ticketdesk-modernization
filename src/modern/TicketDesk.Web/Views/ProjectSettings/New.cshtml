@* Port of the legacy Views/ProjectSettings/New.cshtml (TicketDesk 2.5, Ms-PL). *@
@using NewStrings = TicketDesk.Localization.Views.ProjectSettings.New
@using TicketDesk.Web.Controllers
@section title
{
    @NewStrings.Title
}
@section Scripts {
}
<main>
    <div class="container">
        <fieldset>
            <legend class="col-lg-8 col-lg-offset-2 col-md-9 col-md-offset-1 col-sm-12">@NewStrings.Legend</legend>
            <div class="col-lg-7 col-lg-offset-3 col-md-8 col-md-offset-2 col-sm-12">
<form action="/admin/project/new" class="form-horizontal" method="post" role="form">@Html.AntiForgeryToken()                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h2 class="panel-title">@NewStrings.Header</h2>
                        </div>
                        <div class="panel-body">
                            @LegacyForm.ValidationSummary(ViewData.ModelState)
                            <div class="form-group">
                                @LegacyForm.Label(ProjectSettingsController.NameField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(ProjectSettingsController.NameField, null, state: ViewData.ModelState)
                                </div>
                            </div>

                            <div class="form-group">
                                @LegacyForm.Label(ProjectSettingsController.DescriptionField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(ProjectSettingsController.DescriptionField, null, state: ViewData.ModelState)
                                </div>
                            </div>

                        </div>

                        <div class="panel-footer">
                            <div class="">
                                <button type="submit" class="btn btn-success" tabindex="10">
                                    <i class="fa fa-plus"></i>&nbsp;&nbsp;@NewStrings.SaveOption
                                </button>&nbsp;&nbsp;
                                <a href="/admin/projects">@NewStrings.BackOption</a>

                            </div>
                        </div>
                    </div>
</form>            </div>
        </fieldset>
    </div>
</main>
