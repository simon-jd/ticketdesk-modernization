@* Port of the legacy Views/Ticket/_TicketFiles.cshtml (TicketDesk 2.5, Ms-PL). *@
@model IReadOnlyList<TicketDesk.Attachments.AttachmentInfo>
@using TicketIndex = TicketDesk.Localization.Views.Ticket.Index
@{
    if (Model.Count > 0)
    {
        <div class="panel panel-info" style="padding-top: 0; padding-bottom: 0;">
            <div class="panel-heading panel-title" style="padding: 3px 5px;">
                @TicketIndex.Files
            </div>
            <div class="panel-body" style="">
                <ul class="list-unstyled list-inline">
                    @foreach (var file in Model)
                    {
                        <li>
                            <a href="@TicketDesk.Web.Controllers.FileController.FileUrl(ViewData["TicketId"]!.ToString()!, file.Name)"><i class="fa fa-file fa-align-left"></i> @file.Name</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
}
