@* Port of the legacy Views/UserAdministration/Edit.cshtml (TicketDesk 2.5, Ms-PL). The delete form now carries a token (S3). *@
@model TicketDesk.Web.Controllers.UserAdministrationController.EditModel
@using EditStrings = TicketDesk.Localization.Views.UserAdministration.Edit
@using ModelStrings = TicketDesk.Localization.Models.Strings
@using TicketDesk.Web.Controllers
@{
    var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
}
@section title
{
    @EditStrings.Title
}
@section scripts
{
    @Bundles.Styles("~/content/select2")
    @Bundles.Scripts("~/bundles/select2")
    <script src="/bundles/select2_locale_@(culture)?v="></script>
    @Bundles.Scripts("~/bundles/admin-edit-user")
    <script type="text/javascript">
        $(document).ready(function () {
            window.adminEditUser.activate({ pendingOptionId: '@Model.PendingRoleId' });
        });
    </script>
}
<main>
    <div class="container">
        <fieldset>
            <legend class="col-lg-8 col-lg-offset-2 col-md-9 col-md-offset-1 col-sm-12">@EditStrings.Legend</legend>
            <div class="col-lg-7 col-lg-offset-3 col-md-8 col-md-offset-2 col-sm-12">
<form action="/admin/user/@Model.Id" class="form-horizontal" method="post" role="form">@Html.AntiForgeryToken()<input id="User_Id" name="User.Id" type="hidden" value="@Model.Id" />                    <div class="panel panel-info">
                        <div class="panel-heading">
                            <h2 class="panel-title">@EditStrings.Header</h2>
                        </div>
                        <div class="panel-body">
                            @LegacyForm.ValidationSummary(ViewData.ModelState)
                            <div class="form-group">
                                @LegacyForm.Label(UserAdministrationController.UserNameField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(UserAdministrationController.UserNameField, Model.UserName, state: ViewData.ModelState)
                                </div>
                            </div>
                            <div class="form-group">
                                @LegacyForm.Label(UserAdministrationController.EmailField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(UserAdministrationController.EmailField, Model.Email, state: ViewData.ModelState)
                                </div>
                            </div>
                            <div class="form-group">
                                @LegacyForm.Label(UserAdministrationController.DisplayNameField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    @LegacyForm.TextBox(UserAdministrationController.DisplayNameField, Model.DisplayName, state: ViewData.ModelState)
                                </div>
                            </div>
                            <div class="form-group">
                                @LegacyForm.Label(UserAdministrationController.IsLockedField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    <label class="checkbox-inline">
                                        @LegacyForm.CheckBox(UserAdministrationController.IsLockedField, Model.IsLocked)
                                        @ModelStrings.Locked_Prompt
                                        @if (Model.IsLocked)
                                        {
                                            <span class="text-muted">
                                                (unlock at: @ViewData["UnlockAt"])
                                            </span>
                                        }
                                    </label>
                                    @LegacyForm.ValidationMessage(UserAdministrationController.IsLockedField, ViewData.ModelState)
                                    <span class="help-block">@ModelStrings.IsLocked_Description</span>
                                </div>
                            </div>
                            <div class="form-group">
                                @LegacyForm.Label(UserAdministrationController.IsDisabledField, "col-sm-3 control-label")
                                <div class="col-sm-9">
                                    <label class="checkbox-inline">
                                        @LegacyForm.CheckBox(UserAdministrationController.IsDisabledField, Model.IsDisabled)
                                        @ModelStrings.Disabled_Prompt
                                    </label>
                                    @LegacyForm.ValidationMessage(UserAdministrationController.IsDisabledField, ViewData.ModelState)
                                    <span class="help-block">@ModelStrings.IsDisabled_Description</span>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label" for="Roles">Roles</label>
                                <div class="col-sm-9">
                                    <div class="input-group input-group-sm">
                                        <select class="form-control input-sm" id="userroles" multiple="multiple" name="Roles">@foreach (var r in Model.AllRoles)
{
@if (Model.RoleIds.Contains(r.Id)) {<option selected="selected" value="@r.Id">@r.DisplayName</option>@Html.Raw("\r\n")} else {<option value="@r.Id">@r.DisplayName</option>@Html.Raw("\r\n")}
}</select>
                                        <span class="field-validation-valid text-danger" data-valmsg-for="Roles" data-valmsg-replace="true"></span>
                                        
                                        <span class="input-group-btn"
                                              data-toggle="tooltip"
                                              data-placement="top"
                                              title="@EditStrings.ShowRoleDescriptions">
                                            <button class="btn btn-default btn-sm" type="button" data-toggle="collapse" href="#collapseRoleDescription" aria-expanded="false" aria-controls="collapseRoleDescription">
                                                <i class="fa fa-info"></i>
                                            </button>
                                        </span>
                                    </div>
                                    <div class="collapse" id="collapseRoleDescription">
                                        <div class="well" style="margin-top: 5px;">
                                            <dl class="list list-inline">
                                                <dt>
                                                    @EditStrings.PendingApproval
                                                </dt>
                                                <dd class="text-muted">
                                                    @EditStrings.PendingApproval_Description
                                                </dd>
                                                <dt>
                                                    @EditStrings.InternalUsers
                                                </dt>
                                                <dd class="text-muted">
                                                    @EditStrings.InternalUsers_Description
                                                </dd>
                                                <dt>
                                                    @EditStrings.HelpDeskStaff
                                                </dt>
                                                <dd class="text-muted">
                                                    @EditStrings.HelpDeskStaff_Description
                                                </dd>
                                                <dt>
                                                    @EditStrings.Administrators
                                                </dt>
                                                <dd class="text-muted">
                                                    @EditStrings.Administrators_Description
                                                </dd>
                                            </dl>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="pull-right">
                                <a href="#" class="btn btn-danger" data-toggle="modal" data-target="#delete-confirm">
                                    <i class="fa fa-remove"></i>&nbsp;&nbsp;@EditStrings.DeleteOption
                                </a>
                            </div>
                            <div class="">
                                <button type="submit" class="btn btn-success" tabindex="10"><i class="fa fa-save"></i>&nbsp;&nbsp;@EditStrings.SaveOption</button>&nbsp;&nbsp;
                                <a href="/admin/users">@EditStrings.BackOption</a>
                            </div>
                        </div>
                    </div>
</form>            </div>
        </fieldset>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="delete-confirm" tabindex="-1" role="dialog" aria-labelledby="delete-confirm-label" aria-hidden="true">
        <div class="modal-dialog">
<form action="/admin/user/delete/@Model.Id" class="form" method="post" role="form">@Html.AntiForgeryToken()                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-label="@EditStrings.CloseOption"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" id="delete-confirm-label">@EditStrings.DeleteConfirmation</h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <div class="alert alert-danger">
                                @EditStrings.DeleteAlert
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">@EditStrings.CancelOption</button>
                        <button type="submit" class="btn btn-primary">@EditStrings.DeleteOption</button>
                    </div>
                </div>
</form>        </div>
    </div>
</main>
