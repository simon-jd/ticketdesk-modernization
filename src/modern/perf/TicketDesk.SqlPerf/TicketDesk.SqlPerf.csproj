<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TicketDesk.SqlPerf</RootNamespace>
    <AssemblyName>td-sqlperf</AssemblyName>
    <Description>Captures the SQL the app's query code sends (EF Core interceptor) and replays it against SQL Server with STATISTICS IO/TIME and actual plans, cold and warm.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\TicketDesk.Data\TicketDesk.Data.csproj" />
    <ProjectReference Include="..\..\Modules\TicketDesk.Tickets\TicketDesk.Tickets.csproj" />
    <ProjectReference Include="..\..\Modules\TicketDesk.Reports\TicketDesk.Reports.csproj" />
    <ProjectReference Include="..\..\Modules\TicketDesk.Users\TicketDesk.Users.csproj" />
    <ProjectReference Include="..\..\Modules\TicketDesk.Attachments\TicketDesk.Attachments.csproj" />
    <ProjectReference Include="..\..\Modules\TicketDesk.Search\TicketDesk.Search.csproj" />
  </ItemGroup>
</Project>
